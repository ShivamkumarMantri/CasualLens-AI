# Google Gemini API Key for Evidence-Grounded AI Assistant & Academic Literature RAG
# Obtain API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional backwards compatibility
GOOGLE_API_KEY=your_gemini_api_key_here

# Default Gemini Model Configuration (gemini-3.5-flash, gemini-3.7-flash, gemini-3.8-flash)
GEMINI_MODEL="gemini-3.5-flash"

# Persistent Vector Database Storage Location (ChromaDB)
# For local development: "data/chroma_db"
# For Docker / Cloud persistent mount: "/mnt/data/chroma_db" or "/app/data/chroma_db"
CHROMADB_PERSIST_DIR="data/chroma_db"

# Streamlit Server Port (Default: 8501)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
